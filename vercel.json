{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/turnierleitung",
      "destination": "/admin.html"
    },
    {
      "source": "/turnierleitung/",
      "destination": "/admin.html"
    },
    {
      "source": "/anzeige/",
      "destination": "/anzeige.html"
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/turnierleitung",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}