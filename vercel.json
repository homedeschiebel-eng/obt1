{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/team-bearbeiten",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/zugang",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/team",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/presse",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/aushang",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/turnierleitung",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/bericht.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(spielplan|tabelle|k-o-baum|statistiken|fairplay|voting|teams|partner)",
      "destination": "/"
    },
    {
      "source": "/teams/:slug",
      "destination": "/"
    },
    {
      "source": "/spiel/:nr",
      "destination": "/"
    }
  ]
}
